+void Widget::setSettingsPage(::Settings::Type page) {
+	if (!_macTabs || _settingsPage.current() == page) {
+		return;
+	}
+	if (page && !_settingsSidebar) {
+		_settingsSidebar = ::Settings::CreateSettingsSidebar(
+			this,
+			controller(),
+			_settingsPage.value(),
+			[=] { showMainMenu(); });
+	}
+	_settingsPage = std::move(page);
+	_settingsSidebar->setVisible(bool(_settingsPage.current()));
+	updateForceDisplayWide();
+	updateControlsGeometry();
+}
