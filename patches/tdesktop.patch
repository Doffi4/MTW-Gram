+object_ptr<Ui::ScrollArea> CreateSettingsSidebar(
+		not_null<QWidget*> parent,
+		not_null<Window::SessionController*> controller,
+		rpl::producer<Type> page,
+		Fn<void()> showMainMenu) {
+	auto result = object_ptr<Ui::ScrollArea>(parent.get());
+	const auto scroll = result.data();
+	const auto viewport = scroll->viewport();
+	viewport->setAutoFillBackground(true);
+	rpl::single(rpl::empty) | rpl::then(style::PaletteChanged()) | rpl::on_next([=] {
+		auto palette = viewport->palette();
+		palette.setColor(viewport->backgroundRole(), st::windowBg->c);
+		viewport->setPalette(palette);
+	}, scroll->lifetime());
+	const auto list = scroll->setOwnedWidget(object_ptr<Ui::VerticalLayout>(scroll));
+	scroll->widthValue() | rpl::on_next([=](int width) {
+		list->resizeToWidth(width);
+	}, list->lifetime());
+
+	const auto inset = st::settingsButton.cardSkip;
+	const auto padding = style::margins(inset, 0, inset, 0);
+	list->add(
+		object_ptr<Ui::FlatLabel>(
+			list,
+			tr::lng_menu_settings(),
+			st::defaultFlatLabel),
+		{ 0, inset, 0, inset },
+		style::al_top);
+
+	const auto add = [&](rpl::producer<QString> label,
+			const style::icon &icon, Fn<void()> clicked, Type type = {}) {
+		const auto row = list->add(object_ptr<SidebarRow>(
+			list, std::move(label), icon, std::move(clicked)), padding);
+		if (type) {
+			rpl::duplicate(page) | rpl::on_next([=](const Type &current) {
+				row->setCurrent(current == type);
+			}, row->lifetime());
+		}
+	};
+	const auto open = [&](rpl::producer<QString> label,
+			const style::icon &icon, Type type) {
+		add(std::move(label), icon, [=] {
+			controller->showSettings(
+				type,
+				Window::SectionShow::Way::ClearStack);
+		}, type);
+	};
+	open(tr::lng_dlg_filter(), st::menuIconSearch, Search::Id());
+	if (!controller->session().supportMode()) {
+		list->add(object_ptr<Cover>(
+			list, controller, controller->session().user()));
+		open(tr::lng_settings_my_account(), st::menuIconProfile, InformationId());
+	}
+	open(tr::lng_keys_legend_section_general(), st::menuIconSettings, GeneralId());
+	open(tr::lng_settings_section_notify(), st::menuIconNotifications, NotificationsId());
+	open(tr::lng_settings_section_privacy(), st::menuIconLock, PrivacySecurityId());
+	open(tr::lng_settings_data_storage(), st::menuIconManage, DataStorageId());
+	open(tr::lng_settings_sessions_title(), st::menuIconUnmute, SessionsId());
+	open(tr::lng_edit_channel_color(), st::menuIconChangeColors, AppearanceId());
+	add(tr::lng_settings_language(), st::menuIconTranslate, [=] {
+		static auto guard = base::binary_guard();
+		guard = LanguageBox::Show(controller);
+	});
+	open(tr::lng_settings_stickers_emoji(), st::menuIconChatBubble, StickersEmojiId());
+	open(tr::lng_settings_section_filters(), st::menuIconShowInFolder, FoldersId());
+	add(tr::lng_main_menu(), st::menuIconSettings, std::move(showMainMenu));
+	return result;
+}
