+ToggleRow CreateToggleRow(
+		not_null<QWidget*> parent,
+		rpl::producer<QString> text,
+		bool checked) {
+	auto row = object_ptr<Button>(
+		parent,
+		std::move(text),
+		st::settingsButtonNoIcon);
+	const auto checkbox = Ui::CreateChild<Ui::Checkbox>(
+		row.data(),
+		QString(),
+		checked);
+	checkbox->hide();
+	row->toggleOn(checkbox->checkedValue());
+	row->toggledChanges(
+	) | rpl::on_next([=](bool value) {
+		checkbox->setChecked(value);
+	}, row->lifetime());
+	return { std::move(row), checkbox };
+}
+
+not_null<Ui::Checkbox*> AddToggleRow(
+		not_null<Ui::VerticalLayout*> container,
+		rpl::producer<QString> text,
+		bool checked) {
+	auto result = CreateToggleRow(container, std::move(text), checked);
+	container->add(std::move(result.row));
+	return result.checkbox;
+}
