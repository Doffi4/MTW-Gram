+			setAccessibleName(_title);
+			update();
+		}, lifetime());
+	}
+
+	void setCurrent(bool current) {
+		if (_current != current) {
+			const auto from = _selection.value(_current ? 1. : 0.);
+			_current = current;
+			_selection.start(
+				[=] { update(); },
+				from,
