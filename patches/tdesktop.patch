+void PaintRowBackground(
+		QPainter &p,
+		QRect geometry,
+		const QBrush &bg,
+		const QBrush &base,
+		FnMut<void()> paintRipple,
+		int selectionWidth) {
+	p.fillRect(geometry, base);
+	const auto inset = st::dialogsRowSelectInset;
+	const auto radius = st::dialogsRowSelectRadius;
+	auto path = QPainterPath();
+	auto plate = geometry.marginsRemoved({ inset, inset, inset, inset });
+	if (selectionWidth > 0 && selectionWidth < plate.width()) {
+		plate.setLeft(geometry.x() + (geometry.width() - selectionWidth) / 2);
+		plate.setWidth(selectionWidth);
+	}
+	path.addRoundedRect(plate, radius, radius);
+	auto hq = PainterHighQualityEnabler(p);
+	if (bg != base) {
+		p.fillPath(path, bg);
+	}
+	if (paintRipple) {
+		p.save();
+		p.setClipPath(path, Qt::IntersectClip);
+		paintRipple();
+		p.restore();
+	}
