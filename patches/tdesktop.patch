+#include <QtGui/QPainterPath>
+
 namespace ChatHelpers {
+namespace {
+
+class ComposerTabs final : public Ui::SettingsSlider {
+public:
+	using SettingsSlider::SettingsSlider;
+
+protected:
+	int resizeGetHeight(int newWidth) override {
+		SettingsSlider::resizeGetHeight(newWidth);
+		return st::defaultPillTabs.height;
+	}
+
+	void paintEvent(QPaintEvent *) override {
+		auto p = Painter(this);
+		const auto hq = PainterHighQualityEnabler(p);
+		const auto inset = st::defaultPillTabs.borderWidth;
+		const auto &font = st().labelStyle.font;
+		p.setPen(Qt::NoPen);
+		p.setBrush(st::windowBgOver);
+		p.drawRoundedRect(rect(), height() / 2., height() / 2.);
+
+		const auto range = getCurrentActiveRange();
+		const auto left = std::max(inset, range.left - st::emojiPanMargins.left());
+		const auto right = std::min(
+			width() - inset,
+			range.left + range.width + st::emojiPanMargins.right());
+		if (range.width && right > left) {
+			const auto h = height() - 2 * inset;
+			p.setBrush(st::windowBg);
+			p.drawRoundedRect(myrtlrect(left, inset, right - left, h), h / 2., h / 2.);
+		}
+
+		auto index = 0;
+		enumerateSections([&](Section &section) {
+			if (section.ripple) {
+				section.ripple->paint(p, section.left, 0, width());
+				if (section.ripple->empty()) {
+					section.ripple.reset();
+				}
+			}
+			const auto label = myrtlrect(section.left, 0, section.width, height());
+			p.setPen((index++ == activeSection()) ? st::windowFg : st::windowSubTextFg);
+			section.label.drawElided(
+				p, label.x(), (height() - font->height) / 2,
+				label.width(), 1, style::al_center);
+			return true;
+		});
+	}
+};
+
+} // namespace
 
