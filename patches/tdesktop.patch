+
+[[nodiscard]] bool CanCaptureAttachment() {
+	auto &app = Core::App();
+	return !app.calls().currentCall()
+		&& !app.calls().currentGroupCall()
+		&& !app.mediaDevices().defaultId(Webrtc::DeviceType::Camera).isEmpty();
+}
+
+void CaptureAttachmentBox(
+		not_null<Ui::GenericBox*> box,
+		Fn<void(QImage)> captured) {
+	const auto track = Settings::AddCameraSubsection(
+		box->uiShow(), box->verticalLayout(), false);
+	if (!track) {
+		box->closeBox();
+		return;
+	}
+	box->setTitle(tr::lng_attach_camera());
+	const auto button = box->addButton(tr::lng_continue(), [=] {
+		auto image = track->frame(Webrtc::FrameRequest());
+		if (!image.isNull()) {
+			const auto done = captured;
+			box->closeBox();
+			done(std::move(image).mirrored(true, false));
+		}
+	});
+	button->setDisabled(true);
+	track->renderNextFrame() | rpl::on_next([=] {
+		button->setDisabled(track->frameSize().isEmpty());
+	}, box->lifetime());
+	track->stateValue() | rpl::skip(1) | rpl::on_next([=](Webrtc::VideoState state) {
+		if (state == Webrtc::VideoState::Inactive) {
+			box->closeBox();
+		}
+	}, box->lifetime());
+	box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+}
+
